#!/bin/sh

staged () {
    git show ":$1"
}

VERSION=$(staged dune-project | sed -n 's/(version \(.*\))/\1/p')
VERSION="V${VERSION//./_}"

check () {
    for file in "$@"; do
        if ! staged "$file" | grep -q "$VERSION"; then
            echo "missing module $VERSION in $file" 1>&2
            exit 1
        fi
    done
}

check "acid/src/acid.ml" "acid/src/versions.ml" "acid-jsoo/src/acid_jsoo.ml" "acid-jsoo/src/versions.ml"
