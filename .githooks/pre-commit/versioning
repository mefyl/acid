#!/bin/sh

staged () {
    git show ":$1"
}

VERSION=$(sed -n 's/(version \(.*\))/\1/p' dune-project)
VERSION="V${VERSION//./_}"

check () {
    for file in "$@"; do
        if ! staged "$f" | grep -q "$VERSION"; then
            echo "missing module $VERSION in $1" 1>&2
            exit 1
        fi
    done
}

check "acid/src/acid.ml" "acid/src/versions.ml" "acid-jsoo/src/acid_jsoo.ml" "acid-jsoo/src/versions.ml"
