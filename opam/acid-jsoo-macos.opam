opam-version: "2.0"
version: "0.12.1"
synopsis: "Base javascript library"
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["mefyl <mefyl@gruntech.org>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/acid"
bug-reports: "https://gitlab.routine.co/routine/acid/-/issues"
depends: [
  "dune" {>= "3.0"}
  "acid-lwt-macos" {= version}
  "js_of_ocaml"
  "js_of_ocaml-ppx"
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-x" "macos" "-p" "acid-jsoo" "-j" jobs "@install"]
]
dev-repo: "git+https://gitlab.routine.co/routine/acid.git"
pin-depends: [
  [
    "schematic-macos.0.19.7"
    "git+ssh://git@gitlab.routine.co/routine/schematic.git#89afc50dd5b899a0bd9e82c502261755f66fb7b2"
  ]
  [
    "stdcompat.19"
    "git+https://github.com/thierry-martinez/stdcompat.git#d53390d788027fe0a2282c4745eb3d1626341f99"
  ]
]
