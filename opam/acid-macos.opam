opam-version: "2.0"
version: "0.13.3"
synopsis: "Base library"
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["mefyl <mefyl@gruntech.org>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/acid"
bug-reports: "https://gitlab.routine.co/routine/acid/-/issues"
depends: [
  "dune" {>= "3.20"}
  "base-macos" {>= "v0.16.0" & < "v0.18.0"}
  "fmt-macos"
  "hlist-macos" {>= "0.2.0" & < "0.3.0"}
  "logs-macos"
  "ocaml-macos" {>= "5.0.0"}
  "ppx_deriving"
  "ppx_here"
  "ppx_here-macos"
  "ptime-macos" {>= "1.2.0"}
  "timmy-macos" {>= "1.0.1" & < "2.0.0"}
]
depopts: [
  "js_of_ocaml"
  "schematic-macos" {>= "0.21.0" & < "0.22.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-x" "macos" "-p" "acid" "-j" jobs "@install"]
]
dev-repo: "git+https://gitlab.routine.co/routine/acid.git"
x-maintenance-intent: ["(latest)"]
