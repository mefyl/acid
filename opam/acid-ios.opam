opam-version: "2.0"
version: "0.13.4"
synopsis: "Base library"
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["mefyl <mefyl@gruntech.org>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/acid"
bug-reports: "https://gitlab.routine.co/routine/acid/-/issues"
depends: [
  "dune" {>= "3.20"}
  "base-ios" {>= "v0.16.0" & < "v0.18.0"}
  "fmt-ios"
  "hlist-ios" {>= "0.2.0" & < "0.3.0"}
  "logs-ios"
  "ocaml-ios" {>= "5.0.0"}
  "ppx_deriving"
  "ppx_here"
  "ppx_here-ios"
  "ptime-ios" {>= "1.2.0"}
  "timmy-ios" {>= "1.2.5" & < "2.0.0"}
]
depopts: [
  "js_of_ocaml"
  "schematic-ios" {>= "0.22.3" & < "0.23.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-x" "ios" "-p" "acid" "-j" jobs "@install"]
]
dev-repo: "git+https://gitlab.routine.co/routine/acid.git"
x-maintenance-intent: ["(latest)"]
