(rule
 (target acid.%{version:acid}.opam)
 (deps
  (:opam ../acid.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run git log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/acid#%H\" }"
     -n1)))))

(rule
 (target acid-ios.opam)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{target}
   (run %{workspace_root}/.logistic/ci/dune/dune_sak.exe rewrite-ios --input
    %{dep:../acid.opam} --cross
    acid,acid-jsoo,acid-lwt,hlist,metaversion,schematic,schematic-jsoo,timmy,base,fmt,logs,lwt,ptime
    --cross-both metapp,ppx_here --cross-exclude schematic-jsoo))))

