(version 1.2.2)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune base fmt ocaml ppx_here ppx_deriving ptime schematic)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/timmy#c704b550073d114e8f4c62ebd53ff68afb9a7e24)))

(dev)
