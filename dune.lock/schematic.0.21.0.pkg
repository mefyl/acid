(version 0.21.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune
   base
   base64
   ezjsonm
   fmt
   hmap
   hlist
   landmarks
   landmarks-ppx
   logs
   ocaml
   ppxlib
   ppx_deriving
   ppx_here
   ptime
   semver2
   uri)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/schematic#59e013071c8cb16b3101cfdcd0edb3652dbb9ec5)))

(dev)
