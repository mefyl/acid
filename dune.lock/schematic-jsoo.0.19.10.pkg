(version 0.19.10)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune
   uri
   ptime
   ppx_here
   fmt
   ezjsonm
   base
   js_of_ocaml
   js_of_ocaml-ppx
   landmarks
   landmarks-ppx
   schematic)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/schematic#30b814b7bc99962ba752c1d41e719e9df76ce2a0)))

(dev)
