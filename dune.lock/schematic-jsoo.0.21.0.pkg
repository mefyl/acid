(version 0.21.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune
   base
   ezjsonm
   fmt
   js_of_ocaml
   js_of_ocaml-ppx
   landmarks
   landmarks-ppx
   ppx_here
   ptime
   schematic
   uri)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/schematic#32940fb86623bcd35be341ef81c744abed2ce442)))

(dev)
