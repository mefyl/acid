(alias
 (name default)
 (deps
  acid.opam
  acid-jsoo.opam
  (alias_rec acid/default)
  (alias_rec acid-jsoo/default)))

(rule
 (target acid.%{version:acid}.opam)
 (deps
  (:opam acid.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (echo
     "url {\n  src: \"git://git@gitlab.routine.co:routine/acid#%{version:acid}\"\n}\n")))))

(rule
 (deps acid.opam)
 (target acid.opam.locked)
 (action
  (run %{bin:opam} lock acid)))

(rule
 (mode
  (promote (until-clean)))
 (alias extdeps)
 (target acid.opam.extdeps)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:awk}
    "/^build: / { exit 0 }; !/^  \"(ocaml|schematic)/ { print($0) }"
    %{dep:acid.opam.locked}))))

(rule
 (target acid-jsoo.%{version:acid-jsoo}.opam)
 (deps
  (:opam acid-jsoo.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (echo
     "url {\n  src: \"git://git@gitlab.routine.co:routine/acid-jsoo#%{version:acid-jsoo}\"\n}\n")))))

(rule
 (deps acid-jsoo.opam)
 (target acid-jsoo.opam.locked)
 (action
  (run %{bin:opam} lock acid-jsoo)))

(rule
 (mode
  (promote (until-clean)))
 (alias extdeps)
 (target acid-jsoo.opam.extdeps)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:awk}
    "/^build: / { exit 0 }; !/^  \"(ocaml|schematic)/ { print($0) }"
    %{dep:acid-jsoo.opam.locked}))))
