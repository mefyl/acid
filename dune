(dirs :standard .logistic)

(alias
 (name default)
 (deps
  acid.opam
  acid-jsoo.opam
  (alias_rec acid/default)
  (alias_rec acid-jsoo/default)))

(rule
 (target acid.%{version:acid}.opam)
 (deps
  (:opam acid.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (echo
     "url {\n  src: \"git://git@gitlab.routine.co:routine/acid#%{version:acid}\"\n}\n")))))

(rule
 (target acid-jsoo.%{version:acid-jsoo}.opam)
 (deps
  (:opam acid-jsoo.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (echo
     "url {\n  src: \"git://git@gitlab.routine.co:routine/acid-jsoo#%{version:acid-jsoo}\"\n}\n")))))

(rule
 (target dune.extdeps.inc)
 (alias extdeps)
 (mode (promote))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:.logistic/dune/extdeps/extdeps.exe}
    generate
    --packages
    acid,acid-jsoo
    --exclude
    schematic))))

(include dune.extdeps.inc)
